{
  "permissions": {
    "allow": [
      "Bash(bash:*)",
      "Bash(git:*)",
      "Bash(node:*)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[TOOL] Bash: $TOOL_INPUT\" >> .claude/logs/tool-audit.log 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[TOOL] Write/Edit: $TOOL_INPUT\" >> .claude/logs/tool-audit.log 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}'   || true ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .claude/logs 2>/dev/null; [ -x scripts/graphify-safe-update.sh ] && (nohup scripts/graphify-safe-update.sh > .claude/logs/graphify-update.log 2>&1 & disown); true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "throughline@throughline": true
  },
  "extraKnownMarketplaces": {
    "throughline": {
      "source": {
        "source": "github",
        "repo": "chien-tan-kieu/throughline",
        "ref": "dist"
      },
      "autoUpdate": true
    }
  }
}